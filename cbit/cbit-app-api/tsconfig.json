{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "sourceRoot": "./src",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "lib": ["ES6", "DOM", "ESNext", "DOM.Iterable"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "scripts", "prisma.config.ts"],
  "ts-node": {
    "files": true
  }
}

